# Copia este archivo como .env y pon tu clave de la API de Anthropic.
# La clave se crea en https://console.anthropic.com/ (la API se factura aparte del plan de claude.ai).
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: token Bearer de la API de X (solo si tienes acceso de lectura). Déjalo vacío si no.
X_BEARER_TOKEN=
